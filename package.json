{
  "name": "anga",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend/node"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend/node",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend/node",
    "start": "npm run start --workspace=backend/node",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend/node"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
